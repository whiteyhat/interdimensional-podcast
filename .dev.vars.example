FAL_KEY=your_fal_key_here
# Optional: the crypto desk runs through your local Grok CLI login (grok login).
NEWSDESK_URL=http://127.0.0.1:8791
NEWSDESK_TOKEN=local
# Comma-separated X handles to watch; defaults to the built-in memecoin/Solana roster.
NEWSDESK_X_HANDLES=

# ---- pump.fun launch. Leave COIN_MINT and TREASURY_WALLET empty until the coin exists:
# the site then shows "Launching soon" and refuses quotes with 409 NOT_LAUNCHED.
# The pump.fun mint address of the show's coin.
COIN_MINT=
# Name and ticker the hosts say on air and the site prints.
COIN_NAME=Frogclench
COIN_TICKER=FROGCLENCH
# Wallet that receives every five-dollar payment. It must already hold a token account
# for the coin (buy a dust amount once) or quotes answer 409 TREASURY.
TREASURY_WALLET=
# Server-side RPC for quotes and payment checks (a Helius free-tier URL is recommended).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# RPC the viewer's browser broadcasts through; defaults to the public mainnet RPC.
CLIENT_RPC_URL=
# Shared secret between the studio and the deployed site for pull/aired. Required in
# production; locally, token-less pulls are allowed only from localhost.
STUDIO_TOKEN=
# Studio only: the deployed site, e.g. https://pepe-chad.example.workers.dev. When set, the
# local worker proxies pull/aired there with STUDIO_TOKEN instead of using its own database.
INTERACT_ORIGIN=
# Dollars one request costs.
INTERACT_USD=5
# Cloudflare Stream Live iframe URL for the public site; empty shows the watch buttons.
STREAM_EMBED_URL=
# Link to the X live broadcast.
X_LIVE_URL=
# Devnet only: tokens per dollar. Bypasses the Jupiter and pump.fun price feeds.
PRICE_FIXED=

# ---- Rehearsal. Before the coin exists there is no chart for the hosts to react to, so the
# chart lane can borrow one. Studio only: never set this on the public site.
# An address follows that coin; "auto" follows whichever live pump.fun coin is trading
# hardest right now, re-picked at most every twenty minutes. Empty follows COIN_MINT.
# This never touches the payment path, which reads COIN_MINT and only COIN_MINT, and the
# public site refuses to display a borrowed chart even if this is set.
CHART_MINT=

# ---- Broadcast. Operator-side only: the deployed Worker never sees these.
# Cloudflare account id: dashboard sidebar on any account page.
CF_ACCOUNT_ID=
# API token with Account > Stream > Edit (My Profile > API Tokens > Create Token > Custom).
CF_STREAM_TOKEN=
# Written by `node scripts/stream.mjs create`; every later stream command reads it.
CF_LIVE_INPUT_ID=
# Build time only (.env.production, not here): D1_DATABASE_ID from `wrangler d1 create`.
