# Separate CPU service; it never receives payment signing keys.
# Both bases are pinned to their multi-arch index digests, so Railway's linux/amd64 and an arm64
# laptop build from the same Node and Python. Move a pin on purpose, never by rebuilding.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS node
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
WORKDIR /app
COPY --from=node /usr/local/bin/node /usr/local/bin/node
# tini runs as PID 1. It hands Railway's SIGTERM to Node, and it reaps an ffmpeg orphaned when a
# renderer's process group is killed, which Node as PID 1 would leave behind as a zombie.
# This ffmpeg does more than encode. OpenCV's Linux wheel decodes colour differently from the
# machine the caps were qualified on, so the desk has ffmpeg convert each take first, and checks
# at boot that the result matches (the "decoder" field of /health). Swapping in another ffmpeg
# build is safe only if that check still reports "convert" or "direct".
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tini libstdc++6 \
 && rm -rf /var/lib/apt/lists/* \
 && PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore \
    pip install --no-cache-dir opencv-python-headless==5.0.0.93 numpy==2.5.3 \
 && useradd --create-home --uid 10001 media
COPY broadcast/sponsor-media.mjs broadcast/sponsor-media.mjs
COPY scripts/wearable-render.py scripts/wearable_panel.py scripts/
COPY public/wearables public/wearables
RUN mkdir -p work/sponsor-media && chown -R media:media work
USER media
# No port is baked in: Railway injects PORT and the desk listens there. SPONSOR_MEDIA_PORT is
# only an override for a host that does not. NODE_ENV=production keeps the test-only video
# host switch shut.
ENV NODE_ENV=production SPONSOR_MEDIA_HOST=0.0.0.0 WEARABLE_PYTHON=python3 PYTHONDONTWRITEBYTECODE=1
EXPOSE 4017
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "broadcast/sponsor-media.mjs"]
