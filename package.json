  "scripts": {
    "dev": "concurrently -n app,desk -c cyan,magenta \"vinext dev --hostname 127.0.0.1 --port 3212\" \"node scripts/newsdesk.mjs\"",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "newsdesk": "node scripts/newsdesk.mjs",
    "dev:app": "vinext dev --hostname 127.0.0.1 --port 3212",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:staging": "D1_DATABASE_NAME=pepe-chad-requests-staging D1_DATABASE_ID=6c07b691-cdbe-4681-82a8-4e14a7c85bcb npm run build && wrangler deploy --config dist/server/wrangler.json --name interdimensional-podcast-staging && npm run build",
